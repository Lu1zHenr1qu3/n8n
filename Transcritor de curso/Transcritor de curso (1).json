      "name": "Convert to File"
    },
    {
      "parameters": {
        "name": "={{\n  (() => {\n    // Defina aqui o nome base manualmente (sem número e sem extensão)\n    const manualBase = 'Curso_Ladeira_Automacoes_inteligentes_N8N';\n\n    // Pega o nome original (que só tem número e extensão), ex.: \" (1).mp3\" ou \"1.mp3\"\n    const original = $('Buscando arquivos dentro da pasta').item.json.name || '';\n\n    // 1) Remove extensão\n    let base = original.replace(/\\.[^.]+$/, '');\n\n    // 2) Extrai número (suporta \" (1)\" no final ou apenas \"1\")\n    //    - pega o último grupo de dígitos no fim da string\n    let num = '';\n    const numParen = base.match(/\\((\\d+)\\)\\s*$/);     // \"(1)\"\n    const numPlain = base.match(/(\\d+)\\s*$/);         // \"1\"\n    if (numParen) num = numParen[1];\n    else if (numPlain) num = numPlain[1];\n\n    // 3) Limpeza do manualBase para underscores\n    let cleanedManual = manualBase\n      .replace(/\\([^)]*\\)/g, '')     // remove trechos entre parênteses\n      .replace(/\\./g, '')            // remove pontos\n      .replace(/\\s*[-–—]\\s*/g, '_')  // \" - \" e travessões -> underscore\n      .replace(/-/g, '_')            // hifens -> underscore\n      .replace(/\\s+/g, '_')          // espaços -> underscore\n      .replace(/_+/g, '_')           // normaliza underscores duplicados\n      .replace(/^_+|_+$/g, '');      // remove underscores das bordas\n\n    const prefix = 'Transcricao';\n    const suffix = 'txt';\n    const numberPart = num ? `_${num}` : '';\n\n    // Formato: Transcricao_<manual>_<numero>_txt\n    return `${prefix}_${cleanedManual}${numberPart}_${suffix}`;\n  })()\n}}",
